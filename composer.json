{
    "name": "yii2-extensions/dynamicform",
    "type": "yii2-extension",
    "description": "Yii2 widget for cloning nested form elements while maintaining accessibility and client validation.",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "yii2-dynamicform",
        "copy DOM element",
        "dynamic form",
        "Yii2 extensions"
    ],
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yii2-extensions/dynamicform/issues",
        "wiki": "https://github.com/yii2-extensions/dynamicform/wiki/",
        "source": "https://github.com/yii2-extensions/dynamicform"
    },
    "authors": [
        {
            "name": "Wanderson Bragança",
            "email": "wanderson.wbc@gmail.com",
            "homepage": "http://wbraganca.com"
        },
        {
            "name": "Stefano Mtangoo",
            "email": "mwinjilisti@gmail.com",
            "homepage": "http://hosannahighertech.co.tz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "yiisoft/yii2": "^2.0.55 || ^22.0",
        "symfony/css-selector": "^6.4||^7.0",
        "symfony/dom-crawler": "^6.4||^7.0"
    },
    "require-dev": {
        "bower-asset/inputmask": "5.0.10",
        "infection/infection": "^0.35",
        "kartik-v/dependent-dropdown": "1.4.9",
        "kartik-v/yii2-krajee-base": "3.0.5",
        "kartik-v/yii2-money": "1.2.3",
        "kartik-v/yii2-number": "1.0.5",
        "kartik-v/yii2-widget-datepicker": "1.4.8",
        "kartik-v/yii2-widget-depdrop": "1.0.6",
        "kartik-v/yii2-widget-fileinput": "1.1.1",
        "kartik-v/yii2-widget-select2": "2.2.5",
        "kartik-v/yii2-widget-timepicker": "1.0.5",
        "kartik-v/yii2-widget-touchspin": "1.2.4",
        "maglnet/composer-require-checker": "^4.7",
        "php-forge/coding-standard": "^0.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "select2/select2": "4.0.13",
        "testo/bridge-infection": "^0.1.9",
        "testo/testo": "^0.10.56",
        "yii2-extensions/phpstan": "^0.4 || ^0.5",
        "yiisoft/yii2-bootstrap5": "^2.0.50"
    },
    "autoload": {
        "psr-4": {
            "Yii2\\Extensions\\DynamicForm\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yii2\\Extensions\\DynamicForm\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        },
        "skills": {
            "source": "skills"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "actionlint": "actionlint",
        "check-dependencies": "composer-require-checker check --config-file=composer-require-checker.json composer.json",
        "codespell": "codespell --config .github/linters/.codespellrc",
        "ecs": "ecs check --fix",
        "ecs-check": "ecs check --ansi",
        "editorconfig-checker": "editorconfig-checker -config .github/linters/.editorconfig-checker.json",
        "gitleaks": "gitleaks git --config .github/linters/.gitleaks.toml --redact",
        "markdownlint": "markdownlint-cli2 --config .github/linters/.markdown-lint.yml '**/*.md'",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=-1 vendor/bin/infection"
        ],
        "mutation-static": "@mutation --static-analysis-tool=phpstan",
        "prettier": "prettier --check --config .prettierrc.json --ignore-path .prettierignore '**/*.md' '**/*.{yml,yaml}'",
        "quality": [
            "@actionlint",
            "@codespell",
            "@editorconfig-checker",
            "@markdownlint",
            "@prettier",
            "@yamllint"
        ],
        "rector": "rector process",
        "rector-check": "rector process --dry-run",
        "security": [
            "@zizmor",
            "@gitleaks"
        ],
        "static": "phpstan --memory-limit=-1",
        "tests": "testo",
        "yamllint": "yamllint -c .github/linters/.yamllint.yml .github",
        "zizmor": "zizmor --persona=pedantic .github"
    },
    "scripts-descriptions": {
        "actionlint": "Lints GitHub Actions workflows with actionlint.",
        "check-dependencies": "Verifies that used symbols are declared as Composer dependencies.",
        "codespell": "Checks spelling with codespell.",
        "ecs": "Applies coding standard fixes with ECS.",
        "ecs-check": "Checks coding standards with ECS without modifying files.",
        "editorconfig-checker": "Checks files against the EditorConfig rules.",
        "gitleaks": "Scans Git history for secrets with Gitleaks.",
        "markdownlint": "Lints Markdown files with markdownlint-cli2.",
        "mutation": "Runs mutation testing with Infection.",
        "mutation-static": "Runs mutation testing with Infection and PHPStan static analysis.",
        "prettier": "Checks Markdown and YAML formatting with Prettier.",
        "quality": "Runs all repository quality checks.",
        "rector": "Applies automated refactoring with Rector.",
        "rector-check": "Previews Rector refactoring without modifying files.",
        "security": "Runs the workflow security and secret scanning checks.",
        "static": "Runs static analysis with PHPStan.",
        "tests": "Runs the Testo test suite.",
        "yamllint": "Lints YAML files with yamllint.",
        "zizmor": "Audits GitHub Actions workflows with zizmor."
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
