# Autodetect text files
* text=auto eol=lf

# ...Unless the name matches the following overriding patterns

# Definitively text files
*.php   text
*.css   text
*.js    text
*.txt   text
*.md    text
*.xml   text
*.json  text
*.json5 text
*.neon  text
*.bat   text
*.sql   text
*.yml   text
*.yaml  text
*.svg   text

# Ensure those won't be messed up with
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ttf   binary

# Minified distribution asset
/src/assets/*.min.js linguist-generated=true -diff

# Exclude files from the archive
/.agents                        export-ignore
/.claude                        export-ignore
/.editorconfig                  export-ignore
/.gitattributes                 export-ignore
/.github                        export-ignore
/.gitignore                     export-ignore
/.nvmrc                         export-ignore
/.prettierignore                export-ignore
/.prettierrc.json               export-ignore
/.styleci.yml                   export-ignore
/AGENTS.md                      export-ignore
/codeception.yml                export-ignore
/codecov.yml                    export-ignore
/composer-require-checker.json  export-ignore
/docs                           export-ignore
/ecs.php                        export-ignore
/infection.json*                export-ignore
/internal                       export-ignore
/package.json                   export-ignore
/package-lock.json              export-ignore
/phpstan*.neon*                 export-ignore
/playwright.config.mjs          export-ignore
/rector.php                     export-ignore
/runtime                        export-ignore
/stryker.config.mjs             export-ignore
/testo.php                      export-ignore
/tests                          export-ignore
/tools                          export-ignore
/vitest*.config.mjs             export-ignore

# Avoid merge conflicts in CHANGELOG
# https://about.gitlab.com/2015/02/10/gitlab-reduced-merge-conflicts-by-90-percent-with-changelog-placeholders/
/CHANGELOG.md merge=union
